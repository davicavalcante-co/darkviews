{
  "name": "corte-final",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/**\" run dev",
    "test": "pnpm -r run test",
    "db:push": "cd packages/db && node --env-file=../../.env node_modules/prisma/build/index.js db push --skip-generate",
    "db:seed": "pnpm --filter @corte/api seed",
    "db:demo": "pnpm --filter @corte/api seed:demo",
    "db:setup": "pnpm db:push && pnpm db:seed",
    "tts:setup": "python3 -m venv .venv-tts && .venv-tts/bin/pip install -q piper-tts",
    "omnivoice:setup": "bash scripts/omnivoice-setup.sh",
    "omnivoice:start": ".claude/skills/omnivoice/scripts/start-backend.sh",
    "omnivoice:stop": ".claude/skills/omnivoice/scripts/stop-backend.sh"
  },
  "devDependencies": {
    "typescript": "^5.6"
  }
}
