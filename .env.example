# Caminho relativo ao arquivo packages/db/prisma/schema.prisma -> ./data/app.db
DATABASE_URL="file:../../../data/app.db"
# Chave mestra AES-256-GCM (32 bytes em hex). Gere com: openssl rand -hex 32
MASTER_KEY=""
# E-mail do admin criado pelo seed (a senha é definida no primeiro acesso)
ADMIN_EMAIL="admin@example.com"
# API escuta só no localhost. Mude para 0.0.0.0 apenas se quiser abrir à rede local.
HOST="127.0.0.1"
PORT="3333"
WEB_ORIGIN="http://localhost:5173"
# true só quando servir por HTTPS
COOKIE_SECURE="false"
# Modelo do Claude usado no roteiro e na análise (login do Claude Code desta máquina)
CLAUDE_MODEL="claude-opus-5-5"
# Opcional: caminho de um modelo do whisper.cpp (ex.: ggml-base.bin) para transcrever a referência
WHISPER_MODEL=""

# Usuário que o servidor MCP do Darkviews representa (Claude Code / Claude Desktop)
DARKVIEWS_EMAIL="admin@example.com"
